<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_bringup</name>
  <version>0.0.0</version>
  <description>Bring up the Ranger base with velocity arbitration and collision monitoring.</description>
  <maintainer email="agilex@todo.todo">agilex</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cmd_vel_arbiter</exec_depend>
  <exec_depend>collision_monitor</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ranger_base</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
