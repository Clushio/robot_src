<?xml version='1.0'?>
<launch>

    <arg name="port_name" default="can0"/>
    <arg name="robot_model" default="ranger_mini_v2"/>
    <arg name="odom_frame" default="odom"/>
    <arg name="base_frame" default="base_link" />
    <arg name="update_rate" default="50" />
    <arg name="odom_topic_name" default="odom" />
    <arg name="publish_odom_tf" default="false" />
    <arg name="stop_velocity_threshold" default="0.01" />
    <arg name="stop_wheel_speed_threshold" default="0.01" />
    <arg name="steering_center_tolerance" default="0.01" />
    <arg name="stop_stable_frames" default="3" />
    <arg name="center_stable_frames" default="3" />
    <arg name="stop_wait_timeout" default="2.0" />
    <arg name="mode_switch_timeout" default="2.0" />
    <arg name="centering_timeout" default="3.0" />

    <include file="$(find ranger_base)/launch/include/ranger_robot_base.launch">
        <arg name="port_name" value="$(arg port_name)"/>
        <arg name="robot_model" value="$(arg robot_model)"/>
        <arg name="odom_frame" value="$(arg odom_frame)"/>
        <arg name="base_frame" value="$(arg base_frame)" />
        <arg name="update_rate" value="$(arg update_rate)" />
        <arg name="odom_topic_name" value="$(arg odom_topic_name)" />
        <arg name="publish_odom_tf" value="$(arg publish_odom_tf)" />
        <arg name="stop_velocity_threshold" value="$(arg stop_velocity_threshold)" />
        <arg name="stop_wheel_speed_threshold" value="$(arg stop_wheel_speed_threshold)" />
        <arg name="steering_center_tolerance" value="$(arg steering_center_tolerance)" />
        <arg name="stop_stable_frames" value="$(arg stop_stable_frames)" />
        <arg name="center_stable_frames" value="$(arg center_stable_frames)" />
        <arg name="stop_wait_timeout" value="$(arg stop_wait_timeout)" />
        <arg name="mode_switch_timeout" value="$(arg mode_switch_timeout)" />
        <arg name="centering_timeout" value="$(arg centering_timeout)" />
    </include>
</launch>
