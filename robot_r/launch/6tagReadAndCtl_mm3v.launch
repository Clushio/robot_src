<launch>
  <arg name="port" default="/dev/ttyUSB0"/>
  <arg name="baudrate" default="38400"/>
  <arg name="x_sign" default="1.0"/>
  <arg name="y_sign" default="1.0"/>
  <arg name="yaw_sign" default="-1.0"/>
  <arg name="xp_bias" default="0.0"/>
  <arg name="yp_bias" default="0.0"/>
  <arg name="angle_bias" default="90.0"/>
  <arg name="udp_feedback_enable" default="true"/>
  <arg name="udp_feedback_host" default="192.168.3.17"/>
  <arg name="udp_feedback_port" default="22222"/>
  <arg name="udp_feedback_rate" default="2.0"/>
  <arg name="tag_abort_timeout" default="10.0"/>

  <node pkg="x2bot_teleop" type="TagCtl" name="TagCtl_service" output="screen">
    <!-- A single valid Tag frame clears the timer; only continuous loss aborts. -->
    <param name="tag_abort_timeout" value="$(arg tag_abort_timeout)"/>
  </node>

  <node pkg="robot_r" type="mm3v_serial_reader.py" name="mm3v_serial_reader" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baudrate" value="$(arg baudrate)"/>
    <param name="frame_id" value="map"/>
    <param name="output_topic" value="/tag_position"/>
    <param name="output_meter" value="false"/>
    <param name="publish_no_tag" value="true"/>
    <!-- Hold the last valid Tag briefly so heartbeat/no-tag frames do not
         alternate /tag_position between valid and z=-99. -->
    <param name="tag_lost_timeout" value="0.5"/>
    <param name="x_sign" value="$(arg x_sign)"/>
    <param name="y_sign" value="$(arg y_sign)"/>
    <param name="yaw_sign" value="$(arg yaw_sign)"/>
    <param name="xp_bias" value="$(arg xp_bias)"/>
    <param name="yp_bias" value="$(arg yp_bias)"/>
    <param name="angle_bias" value="$(arg angle_bias)"/>
    <param name="udp_feedback_enable" value="$(arg udp_feedback_enable)"/>
    <param name="udp_feedback_host" value="$(arg udp_feedback_host)"/>
    <param name="udp_feedback_port" value="$(arg udp_feedback_port)"/>
    <param name="udp_feedback_rate" value="$(arg udp_feedback_rate)"/>
  </node>
</launch>
