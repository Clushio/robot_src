<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_r</name>
  <version>0.0.0</version>
  <description>Robot launch orchestration, RViz controls, and deployment configuration.</description>
  <maintainer email="jgl20@todo.todo">jgl20</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lio_lite</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>livx2pcl</exec_depend>
  <exec_depend>mxb_move_base</exec_depend>
  <exec_depend>nav_benchmark</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>pcd2pgm</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>ranger_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>x2bot_teleop</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
